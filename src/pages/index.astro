---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudyCard from '../components/StudyCard.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import RatingPill from '../components/RatingPill.astro';
import { getCollection } from 'astro:content';
import { topics, ratingOrder } from '../data/topics';
import { citations } from '../data/citations';

const studies = (await getCollection('studies'))
  .sort((a, b) => b.data.year - a.data.year);
const featured = studies.filter((s) => s.data.featured).slice(0, 4);
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const sortedTopics = [...topics].sort((a, b) => ratingOrder.indexOf(a.rating) - ratingOrder.indexOf(b.rating));
const counts = ratingOrder.map((r) => ({ r, n: topics.filter((t) => t.rating === r).length }));
const nSources = Object.keys(citations).length;
---

<BaseLayout
  title="Sound Evidence"
  description="An honest, searchable library of the research behind sound healing, music and wellbeing claims. Educational, not medical advice."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Sound healing, fact-checked</span>
        <h1>
          Sound Evidence
          <span class="hero-italic">what the research really says</span>
        </h1>
        <p class="lede">
          Music and sound can do real good, and some claims about them go far beyond the science. This library sorts
          the claims people make about sound baths, singing bowls, binaural beats, 432 Hz and music therapy by how
          well the evidence actually supports them.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/evidence/">Open the evidence table</a>
          <a class="btn btn-ghost" href="/how-to-read/">How to read the evidence</a>
        </div>
      </div>
      <aside class="hero-card">
        <h2>At a glance</h2>
        <p class="small">{topics.length} claims rated, {nSources} sources checked against PubMed, Crossref or the original publisher.</p>
        <div class="rating-summary">
          {counts.map(({ r, n }) => (
            <span><RatingPill rating={r} /> <strong>{n}</strong></span>
          ))}
        </div>
        <p class="small muted" style="margin-top:1rem">
          Strongest: music for anxiety and pain around surgery. Not supported: 432/528 Hz healing and
          energy-field claims.
        </p>
      </aside>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Browse by claim</h2>
          <p class="muted">Each topic has a plain-language verdict, what it does and doesn’t show, and linked sources.</p>
        </div>
        <a href="/evidence/">Searchable table →</a>
      </div>
      <div class="topic-grid">
        {sortedTopics.map((t) => (
          <a class="topic-card" href={`/evidence/${t.slug}/`}>
            <RatingPill rating={t.rating} />
            <h3>{t.title}</h3>
            <p>“{t.claim}”</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="callout" style="display:flex;flex-wrap:wrap;gap:1rem 2rem;align-items:center;justify-content:space-between">
        <div style="max-width:40rem">
          <h2 style="margin-bottom:0.3rem">Work with sound?</h2>
          <p class="small muted">A phrase bank and plain-language guide to describing benefits accurately, with what U.S. regulators expect from health claims.</p>
        </div>
        <a class="btn btn-primary" href="/for-practitioners/">For practitioners</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Featured study cards</h2>
          <p class="muted">Longer notes on landmark reviews. Always check the original paper.</p>
        </div>
        <a href="/studies/">All study cards →</a>
      </div>
      <div class="card-grid">
        {featured.map((study) => <StudyCard study={study} />)}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Recent briefs</h2>
          <p class="muted">Institutional and press notes we track for context.</p>
        </div>
        <a href="/news/">News →</a>
      </div>
      <div class="card-grid">
        {news.map((item) => (
          <article class="card">
            <div class="meta">
              <span class="pill pill-muted">{item.data.source}</span>
              <span class="pill pill-muted">{item.data.date.toISOString().slice(0, 10)}</span>
            </div>
            <a class="card-title" href={`/news/${item.slug}/`}>{item.data.title}</a>
            <p class="small">{item.data.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <SubscribeForm />
    </div>
  </section>
</BaseLayout>
