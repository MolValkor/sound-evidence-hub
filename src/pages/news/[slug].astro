---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('news');
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
---

<BaseLayout title={item.data.title} description={item.data.summary}>
  <article class="section">
    <div class="container prose">
      <p><a href="/news/">← News</a></p>
      <div class="meta" style="margin-bottom:1rem">
        <span class="pill pill-muted">{item.data.source}</span>
        <span class="pill pill-muted">{item.data.date.toISOString().slice(0, 10)}</span>
      </div>
      <h1>{item.data.title}</h1>
      <p class="lede">{item.data.summary}</p>
      <Content />
      <p style="margin-top:2rem">
        <a class="btn btn-primary" href={item.data.url} rel="noopener noreferrer" target="_blank">Open original</a>
      </p>
      <p class="small muted">Educational context only — not medical advice.</p>
    </div>
  </article>
</BaseLayout>
